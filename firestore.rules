rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // FASA AWAL (tiada login lagi): buka untuk baca & tulis
    // supaya app boleh jalan dulu semasa development.
    // TUKAR rules ni bila login (Firebase Auth) sudah ditambah,
    // contoh selepas ada auth:
    //   allow read, write: if request.auth != null;
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
